# Environment for the study on Sharanga (BITS Hyderabad HPC). Sourced by setup_sharanga.sh, submit.sh,
# run_study.sh (WM_ENV) and check_sharanga.sh. Everything large lives on /scratch ($HOME has a 40 GiB quota);
# only the private keys and a copy of the results stay in $HOME (backed up). Any variable can be set beforehand.
#
# /scratch deletes files 15 days after their last modification. wm_refresh (run at every job start and by
# setup) touches files older than 7 days under WM_ROOT, so the venv, weights, repo and dumps survive between runs.
# Between runs longer than a week apart, run `source promptset/job/sharanga.env && wm_refresh` once.

export WM_ROOT="${WM_ROOT:-/scratch/$USER/wm}"            # venv, HF cache, caches (the repo should be in here too)
export VENV="${VENV:-$WM_ROOT/venv}"
export HF_HOME="${HF_HOME:-$WM_ROOT/hf}"                  # model weights (~30 GB for Qwen3-14B)
export PIP_CACHE_DIR="${PIP_CACHE_DIR:-$WM_ROOT/cache/pip}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$WM_ROOT/cache}"
export MPLCONFIGDIR="${MPLCONFIGDIR:-$WM_ROOT/cache/matplotlib}"
export WM_RESULTS="${WM_RESULTS:-$HOME/wm/results}"       # small copy of report.md, results/, analysis/ per dump
export WM_PARTITION="${WM_PARTITION:-gpu_h200_8}"         # gpu_h200_8 | gpu_h100_4 | gpu_a100_8 (see submit.sh)
export WM_MAX_CHAIN="${WM_MAX_CHAIN:-8}"                  # automatic resubmissions after a time limit

wm_refresh() {
  local d
  for d in "$WM_ROOT" "$@"; do
    [[ -d "$d" ]] && find "$d" -xdev -mtime +7 \( -type f -o -type d \) -exec touch -c -h {} + 2>/dev/null
  done
  return 0
}
